generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Mirrors the signed-in Supabase user (`auth.users.id`).
model User {
  id        String   @id @db.Uuid
  email     String
  createdAt DateTime @default(now())
  displayName String?
  ageRange    String?
  onboardingCompletedAt DateTime?

  languageProfile LanguageProfile?
  entries         JournalEntry[]
  learningLanguages UserLanguage[]
  flashcards      Flashcard[]
  flashcardPracticeStats FlashcardPracticeStats?
}

enum FlashcardProficiency {
  NEW
  LEARNING
  FAMILIAR
  MASTERED
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum LevelConfidence {
  LOW
  MEDIUM
  HIGH
}

enum PromptMode {
  ACADEMIC
  FUN
}

enum PromptStatus {
  ACTIVE
  DISABLED
  NEEDS_REVIEW
}

enum PromptSource {
  CURATED
  LLM_GENERATED
}

/// A language the user is learning, with their proficiency level.
model UserLanguage {
  id            String @id @default(uuid()) @db.Uuid
  userId        String @db.Uuid
  languageCode  String
  level         String
  /// Hidden estimate for prompts / future calibration; not shown in UI.
  estimatedCefrLevel CefrLevel @default(A1)
  levelConfidence    LevelConfidence @default(LOW)
  estimatedLevelUpdatedAt DateTime?
  /// Effective CEFR level for daily prompt selection; separate from self-reported level.
  currentPromptLevel CefrLevel?
  /// Per-level lists of prompt indexes already shown, e.g. { "A1": [0, 3, 7] }.
  seenPromptIndexes Json @default("{}")
  tooEasyStreak Int @default(0)
  tooHardStreak Int @default(0)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, languageCode])
  @@index([userId])
}

model Prompt {
  id            String @id @default(cuid())
  languageCode  String @default("any")
  mode          PromptMode
  minCefr       CefrLevel
  maxCefr       CefrLevel
  topicTags     String[] @default([])
  safetyTags    String[] @default([])
  requiredWords String[] @default([])
  promptText    String
  status        PromptStatus @default(ACTIVE)
  source        PromptSource @default(CURATED)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usages        PromptUsage[]

  @@index([languageCode, mode])
  @@index([status])
}

model PromptUsage {
  id        String @id @default(cuid())
  userId    String @db.Uuid
  promptId  String
  entryId   String? @db.Uuid
  usedAt    DateTime @default(now())

  prompt Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([promptId, usedAt])
}

model LanguageProfile {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @unique @db.Uuid
  nativeLanguage  String
  targetLanguage  String
  uiLocale        String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JournalEntry {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  title        String?
  body         String?  @db.Text
  translations Json?
  entryDate    DateTime @db.Date
  /// Index into the static prompt list for the assigned CEFR level.
  promptIndex  Int?
  promptLevel  CefrLevel?
  /// Set when the user marks today's entry as done for the day.
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]

  @@index([userId, entryDate])
  @@index([userId])
}

model Flashcard {
  id              String @id @default(uuid()) @db.Uuid
  userId          String @db.Uuid
  word            String
  translation     String
  exampleSentence String? @db.Text
  audioMimeType   String?
  languageCode    String
  proficiency     FlashcardProficiency @default(NEW)
  entryId         String? @db.Uuid
  translationId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry JournalEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@unique([userId, languageCode, word])
  @@index([userId, proficiency])
  @@index([userId, languageCode])
  @@index([userId, createdAt])
}

model FlashcardPracticeStats {
  userId           String @id @db.Uuid
  currentStreak    Int @default(0)
  lastPracticeDate DateTime? @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
